rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAnonymous() {
      return request.auth != null &&
        request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    function validRoom(roomId) {
      return request.resource.data.keys().hasOnly([
        'id','version','gameName','createdAt','updatedAt',
        'players','seats','rates','entries','nextSeq'
      ]) &&
      request.resource.data.id == roomId &&
      request.resource.data.version == 2 &&
      request.resource.data.gameName is string &&
      request.resource.data.gameName.size() <= 35 &&
      request.resource.data.players is list &&
      request.resource.data.players.size() >= 4 &&
      request.resource.data.players.size() <= 100 &&
      request.resource.data.seats is list &&
      request.resource.data.seats.size() == 4 &&
      request.resource.data.rates is map &&
      request.resource.data.entries is list &&
      request.resource.data.entries.size() <= 1300 &&
      request.resource.data.nextSeq is int &&
      request.resource.data.createdAt is int &&
      request.resource.data.updatedAt is int;
    }
    match /mahjong_rooms_v4/{roomId} {
      // 无角色和密码的互信牌友模式：访问网站的匿名用户均能查看、编辑和删除房间。
      // 并非私人加密房间；不要存储敏感信息。
      allow read: if isAnonymous();
      allow create, update: if isAnonymous() && validRoom(roomId);
      allow delete: if isAnonymous();
    }
  }
}
